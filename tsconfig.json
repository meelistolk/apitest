{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "models/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
